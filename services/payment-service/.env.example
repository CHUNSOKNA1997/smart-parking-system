# Server Configuration
NODE_ENV=development
PORT=3003
SERVICE_NAME=payment-service

# Database Configuration (Local PostgreSQL)
# Format: postgresql://username:password@host:port/database
DATABASE_URL="postgresql://postgres:password@localhost:5432/payment_db"

# JWT Configuration (shared with auth-service for token verification)
JWT_SECRET="your-secret-key-here"
JWT_EXPIRE=7d

# Auth Service URL (for user verification)
AUTH_SERVICE_URL=http://localhost:3001

# PayWay Configuration
# Get these from: https://sandbox.payway.com.kh/
PAYWAY_MERCHANT_ID=your_merchant_id
PAYWAY_API_KEY=your_api_key
PAYWAY_API_URL=https://checkout-sandbox.payway.com.kh/api/payment-gateway/v1/payments/purchase

# PayWay Webhook URL (ngrok or production URL)
# 
# For LOCAL DEVELOPMENT with ngrok:
# 1. Install ngrok: https://ngrok.com/download
# 2. Start ngrok: ngrok http 3003
# 3. Copy the https URL (e.g., https://abc123.ngrok.io)
# 4. Paste below WITHOUT the trailing slash
# 5. Restart the service
#
# For PRODUCTION:
# Use your production domain (e.g., https://api.yourapp.com)
#
# Leave EMPTY if you don't need webhook (status will stay PENDING)
PAYWAY_WEBHOOK_BASE_URL=

# Parking Service URL (for booking updates)
PARKING_SERVICE_URL=http://localhost:3002

# CORS Origin
CORS_ORIGIN=http://localhost:8080,http://localhost:3000
