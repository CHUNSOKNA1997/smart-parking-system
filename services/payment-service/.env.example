# Server Configuration
NODE_ENV=development
PORT=3003
SERVICE_NAME=payment-service

# Database Configuration (Local PostgreSQL)
# Format: postgresql://username:password@host:port/database
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/payment_db"

# JWT Configuration (shared with auth-service for token verification)
JWT_SECRET=""
JWT_EXPIRE=7d

# Auth Service URL (for user verification)
AUTH_SERVICE_URL=http://localhost:3001

# Bakong API Configuration
BAKONG_DEV_BASE_API_URL="https://sit-api-bakong.nbc.gov.kh/v1"
BAKONG_PROD_BASE_API_URL="https://api-bakong.nbc.gov.kh/v1"
BAKONG_ACCESS_TOKEN=""

# KHQR Merchant Account (get these from NBC Bakong Merchant Portal)
# KHQR_MERCHANT_ID: Optional - Only required for registered merchants
#                   For personal Bakong accounts, leave empty
# KHQR_ACCOUNT_ID: Required - Your Bakong account ID (e.g., username@bank)
KHQR_MERCHANT_ID=""
KHQR_MERCHANT_NAME=""
KHQR_ACCOUNT_ID=""
KHQR_CURRENCY="USD"
KHQR_STORE_LABEL=""
KHQR_TERMINAL_LABEL=""

# App Configuration (for payment deeplink callback)
APP_NAME="Smart Parking"
APP_ICON_URL=""
APP_DEEPLINK_CALLBACK=""

# Payment Configuration
# QR code expiration time in minutes (default: 15 minutes)
PAYMENT_QR_EXPIRATION_MINUTES=15

# CORS Origin
CORS_ORIGIN=http://localhost:8080,http://localhost:3000
