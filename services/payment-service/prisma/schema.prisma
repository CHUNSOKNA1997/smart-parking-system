// Prisma Schema for Smart Parking System
// Payment Service - manages PayWay QR payments and transactions

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Payment Status Enum
enum PaymentStatus {
    PENDING
    PAID
    FAILED
    CANCELLED
    REFUNDED
    EXPIRED
}

// Currency Enum
enum Currency {
    USD
    KHR
}

// Transactions table
model Transaction {
    id                String         @id @default(uuid()) @map("payment_id") @db.Uuid
    bookingId         String?        @map("booking_id") @db.Uuid // Deprecated: kept for backward compatibility
    userId            String         @map("user_id") @db.Uuid
    amount            Decimal        @db.Decimal(10, 2)
    currency          Currency       @default(USD)
    qrString          String?        @map("qr_string") @db.Text
    deeplinkUrl       String?        @map("deeplink_url") @db.Text
    transactionHash   String?        @unique @map("transaction_hash") @db.VarChar(255)
    status            PaymentStatus  @default(PENDING)
    paymentMethod     String         @default("payway") @map("payment_method") @db.VarChar(20)
    description       String?        @db.Text
    metadata          Json?
    paidAt            DateTime?      @map("paid_at")
    expiresAt         DateTime?      @map("expires_at")
    createdAt         DateTime       @default(now()) @map("created_at")
    updatedAt         DateTime       @updatedAt @map("updated_at")

    // Relations
    bookings          PaymentBooking[]

    @@index([userId])
    @@index([bookingId])
    @@index([status])
    @@index([transactionHash])
    @@index([createdAt])
    @@map("transactions")
}

// Payment-Booking Junction Table
// Supports multiple bookings per payment (e.g., user books 3 parking spots in one transaction)
model PaymentBooking {
    id          String       @id @default(uuid()) @db.Uuid
    paymentId   String       @map("payment_id") @db.Uuid
    bookingId   String       @map("booking_id") @db.Uuid
    amount      Decimal      @db.Decimal(10, 2) // Individual booking amount
    createdAt   DateTime     @default(now()) @map("created_at")

    // Relations
    payment     Transaction  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

    @@unique([paymentId, bookingId])
    @@index([paymentId])
    @@index([bookingId])
    @@map("payment_bookings")
}

// Idempotency Keys table
// Prevents duplicate payment creation from retry requests
model IdempotencyKey {
    id           String   @id @default(uuid()) @db.Uuid
    key          String   @unique @db.VarChar(255)
    requestHash  String   @map("request_hash") @db.VarChar(64)
    response     Json
    statusCode   Int      @map("status_code")
    createdAt    DateTime @default(now()) @map("created_at")
    expiresAt    DateTime @map("expires_at")

    @@index([key])
    @@index([expiresAt])
    @@map("idempotency_keys")
}
