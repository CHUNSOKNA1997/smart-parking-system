// Prisma Schema for Smart Parking System
// Payment Service - manages PayWay QR payments and transactions

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Payment Status Enum
enum PaymentStatus {
    PENDING
    PAID
    FAILED
    CANCELLED
    REFUNDED
    EXPIRED
}

// Currency Enum
enum Currency {
    USD
    KHR
}

// PayWay Payments table
// NOTE: Model name kept as KHQRPayment for backward compatibility with existing database
// Table maps to "khqr_payments" to avoid migration
model KHQRPayment {
    id                String         @id @default(uuid()) @map("payment_id") @db.Uuid
    bookingId         String?        @map("booking_id") @db.Uuid
    userId            String         @map("user_id") @db.Uuid
    amount            Decimal        @db.Decimal(10, 2)
    currency          Currency       @default(USD)
    qrString          String?        @map("qr_string") @db.Text
    deeplinkUrl       String?        @map("deeplink_url") @db.Text
    transactionHash   String?        @unique @map("transaction_hash") @db.VarChar(255)
    status            PaymentStatus  @default(PENDING)
    paymentMethod     String         @default("payway") @map("payment_method") @db.VarChar(20)
    description       String?        @db.Text
    metadata          Json?
    paidAt            DateTime?      @map("paid_at")
    expiresAt         DateTime?      @map("expires_at")
    createdAt         DateTime       @default(now()) @map("created_at")
    updatedAt         DateTime       @updatedAt @map("updated_at")

    @@index([userId])
    @@index([bookingId])
    @@index([status])
    @@index([transactionHash])
    @@index([createdAt])
    @@map("khqr_payments")
}
