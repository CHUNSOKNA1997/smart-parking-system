# Server Configuration
NODE_ENV=development
PORT=3003
SERVICE_NAME=payment-service

# Database Configuration (Docker PostgreSQL)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@postgres-payment:5432/payment_db?schema=public"

# JWT Configuration (shared with auth-service for token verification)
JWT_SECRET=YOUR_JWT_SECRET_KEY_HERE
JWT_EXPIRE=7d

# Auth Service URL (for user verification - Docker service name)
AUTH_SERVICE_URL=http://auth-service:3001

# Bakong API Configuration
BAKONG_DEV_BASE_API_URL=https://sit-api-bakong.nbc.gov.kh/v1
BAKONG_PROD_BASE_API_URL=https://api-bakong.nbc.gov.kh/v1
BAKONG_ACCESS_TOKEN=YOUR_BAKONG_ACCESS_TOKEN_HERE

# KHQR Merchant Account (get these from NBC Bakong Merchant Portal)
# For personal Bakong accounts, leave KHQR_MERCHANT_ID empty (will use KHQR_ACCOUNT_ID)
# The account ID serves as both merchant ID and account ID for personal accounts
KHQR_MERCHANT_ID=
KHQR_MERCHANT_NAME=Smart Parking
KHQR_ACCOUNT_ID=your_account@bank
KHQR_CURRENCY=USD
KHQR_STORE_LABEL=Main Store
KHQR_TERMINAL_LABEL=Terminal 01

# App Configuration (for payment deeplink callback)
APP_NAME=Smart Parking
APP_ICON_URL=https://smartparking.com/logo.png
APP_DEEPLINK_CALLBACK=http://localhost:8080/payment/callback

# Payment Configuration
PAYMENT_QR_EXPIRATION_MINUTES=15

# CORS Origin
CORS_ORIGIN=http://localhost:8080,http://localhost:3000,http://gateway:3000
