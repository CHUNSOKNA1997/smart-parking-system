# Server Configuration
NODE_ENV=development
PORT=3001
SERVICE_NAME=auth-service

# Database Configuration (Docker PostgreSQL)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@postgres-auth:5432/auth_db?schema=public"

# JWT Configuration
JWT_SECRET=YOUR_JWT_SECRET_KEY_HERE
JWT_EXPIRE=7d

# Email Configuration (Gmail SMTP)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=Smart Parking <noreply@smartparking.com>

# Frontend URL (for email verification links)
FRONTEND_URL=http://localhost:8080

# CORS Origin
CORS_ORIGIN=http://localhost:8080,http://localhost:3000,http://gateway:3000
