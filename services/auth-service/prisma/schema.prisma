// Prisma Schema for Smart Parking System
// Auth Service - manages users table

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Users table - Auth Service owns this table
model User {
  id                 String    @id @default(uuid()) @map("user_id") @db.Uuid
  firstName          String    @map("first_name") @db.VarChar(50)
  lastName           String    @map("last_name") @db.VarChar(50)
  email              String    @unique @db.VarChar(100)
  passwordHash       String    @map("password_hash") @db.VarChar(255)
  isVerified         Boolean   @default(false) @map("is_verified")
  phone              String?   @db.VarChar(20)
  profileImage       String?   @map("profile_image") @db.VarChar(255)
  verificationOtp    String?   @map("verification_otp") @db.VarChar(6)
  otpExpiry          DateTime? @map("otp_expiry")
  resetOtp           String?   @map("reset_otp") @db.VarChar(6)
  resetOtpExpiry     DateTime? @map("reset_otp_expiry")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  refreshToken       RefreshToken?

  @@index([email])
  @@index([verificationOtp])
  @@index([resetOtp])
  @@map("users")
}

// Refresh tokens (single device per user)
model RefreshToken {
  id        String   @id @default(uuid()) @map("refresh_token_id") @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}
