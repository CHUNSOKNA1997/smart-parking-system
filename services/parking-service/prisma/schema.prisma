// Prisma Schema for Smart Parking System
// Parking Service - manages parking spots, bookings, transactions
// Note: User data is owned by auth-service, accessed via HTTP API

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum BookingStatus {
  RESERVED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum SpotType {
  CAR
  MOTORCYCLE
}

enum PaymentMethod {
  CASH
  KHQR
  ABA
  CARD
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// Parking Spots table
model ParkingSpot {
  id           String    @id @default(uuid()) @map("spot_id") @db.Uuid
  spotName     String    @unique @map("spot_name") @db.VarChar(20)
  spotType     SpotType  @map("spot_type")
  isAvailable  Boolean   @default(true) @map("is_available")
  pricePerHour Decimal   @default(2.00) @map("price_per_hour") @db.Decimal(10, 2)
  lastUpdated  DateTime  @default(now()) @map("last_updated")
  createdAt    DateTime  @default(now()) @map("created_at")

  bookings Booking[]

  @@index([isAvailable])
  @@index([spotType])
  @@index([spotName])
  @@map("parking_spots")
}

// Bookings table
model Booking {
  id            String        @id @default(uuid()) @map("booking_id") @db.Uuid
  userId        String        @map("user_id") @db.Uuid // Reference to auth-service User (no FK)
  spotId        String        @map("spot_id") @db.Uuid
  startTime     DateTime      @default(now()) @map("start_time")
  endTime       DateTime?     @map("end_time")
  durationHours Decimal?      @map("duration_hours") @db.Decimal(4, 2)
  totalPrice    Decimal?      @map("total_price") @db.Decimal(10, 2)
  currency      String?       @default("USD") @db.VarChar(3)
  status        BookingStatus @default(RESERVED)
  qrCode        String?       @map("qr_code") @db.Text
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  spot         ParkingSpot   @relation(fields: [spotId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
  @@index([spotId])
  @@index([status])
  @@index([startTime, endTime])
  @@map("bookings")
}

// Transactions table
model Transaction {
  id              String            @id @default(uuid()) @map("transaction_id") @db.Uuid
  bookingId       String?           @map("booking_id") @db.Uuid
  userId          String            @map("user_id") @db.Uuid // Reference to auth-service User (no FK)
  amount          Decimal           @db.Decimal(10, 2)
  paymentMethod   PaymentMethod     @default(CASH) @map("payment_method")
  status          TransactionStatus @default(COMPLETED)
  description     String?           @db.Text
  transactionDate DateTime          @default(now()) @map("transaction_date")

  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([bookingId])
  @@index([transactionDate])
  @@map("transactions")
}
