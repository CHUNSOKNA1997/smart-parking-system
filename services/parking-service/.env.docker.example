# Server Configuration
NODE_ENV=development
PORT=3002
SERVICE_NAME=parking-service

# Database Configuration (Docker PostgreSQL)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@postgres-parking:5432/parking_db?schema=public"

# JWT Configuration
JWT_SECRET=YOUR_JWT_SECRET_KEY_HERE
JWT_EXPIRE=7d

# Auth Service URL (for token verification - Docker service name)
AUTH_SERVICE_URL=http://auth-service:3001

# Email Configuration (Gmail SMTP)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=Smart Parking <noreply@smartparking.com>

# Frontend URL (for email verification links)
FRONTEND_URL=http://localhost:8080

# CORS Origin
CORS_ORIGIN=http://localhost:8080,http://localhost:3000,http://gateway:3000

# Pricing
DEFAULT_HOURLY_RATE_CAR=2.00
DEFAULT_HOURLY_RATE_MOTORCYCLE=1.00

# IoT Configuration
IOT_API_KEY=your-iot-api-key-here
