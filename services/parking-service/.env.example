# Server Configuration
NODE_ENV=development
PORT=3002
SERVICE_NAME=parking-service

# Database Configuration (Local PostgreSQL)
# Format: postgresql://username:password@host:port/database
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/parking_db"

# JWT Configuration
JWT_SECRET=""
JWT_EXPIRE=7d

# Auth Service URL (for token verification)
AUTH_SERVICE_URL=http://localhost:3001

# Email Configuration (Gmail SMTP)
EMAIL_SERVICE=gmail
EMAIL_USER=""
EMAIL_PASSWORD=""
EMAIL_FROM=Smart Parking <noreply@smartparking.com>

# Frontend URL (for email verification links)
FRONTEND_URL=http://localhost:8080

# CORS Origin
CORS_ORIGIN=http://localhost:8080,http://localhost:3000

# Pricing
DEFAULT_HOURLY_RATE_CAR=2.00
DEFAULT_HOURLY_RATE_MOTORCYCLE=1.00
