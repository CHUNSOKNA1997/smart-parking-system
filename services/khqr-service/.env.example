# Server Configuration
NODE_ENV=development
PORT=3003
SERVICE_NAME=khqr-service

# Database Configuration (Local PostgreSQL)
# Format: postgresql://username:password@host:port/database
DATABASE_URL="postgresql://postgres:12345678@localhost:5432/auth_db"

# JWT Configuration (shared with auth-service for token verification)
JWT_SECRET=""
JWT_EXPIRE=7d

# Auth Service URL (for user verification)
AUTH_SERVICE_URL=http://localhost:3001

# Bakong/KHQR API Configuration
BAKONG_DEV_BASE_API_URL="https://sit-api-bakong.nbc.gov.kh/v1"
BAKONG_PROD_BASE_API_URL="https://api-bakong.nbc.gov.kh/v1"
BAKONG_ACCOUNT_USERNAME=""
BAKONG_MERCHANT_ID=""
BAKONG_ACCESS_TOKEN=""

# KHQR Merchant Account (from Bakong Merchant Portal)
KHQR_MERCHANT_ID=""
KHQR_MERCHANT_NAME=""
KHQR_ACCOUNT_ID=""
KHQR_CURRENCY="USD"
KHQR_STORE_LABEL=""
KHQR_TERMINAL_LABEL=""

# App Configuration (for payment deeplink callback)
APP_NAME="Smart Parking"
APP_ICON_URL=""
APP_CALLBACK_URL=""

# CORS Origin
CORS_ORIGIN=http://localhost:8080,http://localhost:3000
